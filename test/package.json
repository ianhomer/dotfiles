{
  "author": "anon",
  "description": "dotme test",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "24.4.0",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "1.0.3",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "license": "ISC",
  "main": "scratch.js",
  "name": "test",
  "type": "module",
  "scripts": {
    "eslint": "eslint . --ext .js,.ts,.tsx",
    "eslint:debug": "DEBUG=eslint:cli-engine eslint . --ext js,ts,tsx",
    "eslint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "lint": "pnpm prettier && pnpm eslint",
    "lint:fix": "pnpm prettier:fix && pnpm eslint:fix",
    "prettier": "pnpx prettier --check .",
    "prettier:fix": "pnpx prettier --write .",
    "start:ts": "ts-node scratch.ts",
    "test": "bats -T fixtures"
  },
  "version": "1.0.0",
  "pnpm": {
    "updateConfig": {
      "ignoreDependencies": [
        "eslint",
        "eslint-plugin-sonarjs"
      ]
    }
  },
  "packageManager": "pnpm@10.15.1"
}
