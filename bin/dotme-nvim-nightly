#!/usr/bin/env bash

#
# Install nightly version of neovim.
#
# See https://github.com/neovim/neovim/releases/tag/nightly
#

set -e

$(shim) && cd ${ME} && . bin/i.sh

nightlyInstallation=~/local/nvim/$(date +%Y%m%d)
if [ ! -d ${nightlyInstallation} ]; then
	log:: "installing nightly nvim ${nightlyInstallation}"
	curl -fLo ~/Downloads/nvim-macos-arm64.tar.gz \
		https://github.com/neovim/neovim/releases/download/nightly/nvim-macos-arm64.tar.gz

	mkdir -p ${nightlyInstallation}
	cd ${nightlyInstallation}
	tar xzf ~/Downloads/nvim-macos-arm64.tar.gz

	[ -L ~/bin/nvim ] && rm ~/bin/nvim
	ln -s ${nightlyInstallation}/nvim-macos-arm64/bin/nvim ~/.local/bin/nvim
else
	if [ ! -f ~/.local/bin/nvim ]; then
		log:: "linking latest nightly to ~/.local/bin/nvim"
		if [ ! -d ~/bin ]; then
			log:: "Creating ~/bin"
			mkdir ~/bin
		fi
		ln -s ${nightlyInstallation}/nvim-macos/bin/nvim ~/.local/bin/nvim
	fi
	log:: "nightly nvim ${nightlyInstallation} already installed"
fi
