#!/usr/bin/env bash

#
# Configure git
#

should-run $0 || exit 0
$(shim) && cd ${ME} && . bin/i.sh

# Make sure ~/.gitconfig is in place before setting git config so that personal
# settings end up in that config file
gitConfigFile=~/.gitconfig
if [[ ! -f $gitConfigFile ]] ; then
  log:: "Creating $gitConfigFile"
  touch $gitConfigFile
fi

git config user.email > /dev/null ||
  git config --global user.email "code@ianhomer.com"

git config user.name > /dev/null ||
  git config --global user.name "Ian Homer"

# Define all hooks
hooks=(applypatch-msg commit-msg post-applypatch post-checkout post-commit post-merge post-rewrite pre-applypatch pre-commit pre-merge-commit pre-push pre-rebase prepare-commit-msg)

# Link them all to the master script
for hook in "${hooks[@]}"; do
  HOOK_LINK=~/.config/git/hooks/$hook
  if [ ! -f ${HOOK_LINK} ] ; then
    log:: Creating $HOOK_LINK
    ln -sf ~/.config/git/hooks/local-hook ~/.config/git/hooks/$hook
  fi
done

should-run -fu $0
