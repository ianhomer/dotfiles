#!/usr/bin/env bash

#
# Clean brew packages
#

should-run -m 7 $@ $0 || exit 0
$(shim) && cd ${ME} && . bin/i.sh

log:: "Autoremoving dependencies no longer needed"
brew autoremove

log:: "Cleaning up brew caches"
brew cleanup

# Clean up manually installed brew commands not
# registered in the Brewfile
brew bundle cleanup --file=../../config/brew/Brewfile

should-run -fu $0
