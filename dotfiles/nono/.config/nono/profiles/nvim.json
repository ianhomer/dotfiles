{
  "meta": {
    "name": "nvim"
  },
  "security": {
    "groups": []
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": ["."],
    "read": [
      "~/.cache",
      "~/.pyenv",
      "~/.config/fish",
      "~/.config/nvim",
      "~/.config/git",
      "~/.local/share/nvim",
      "/opt/homebrew/Cellar/neovim/"
    ]
  }
}
